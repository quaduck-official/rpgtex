%=======================================================================================
%   RPGLAYOUT
%=======================================================================================

\ProvidesExplPackage
    {rpglayout}
    {2026-07-09}
    {0.1}
    {Page layout controls for RPG typesetting.}

\RequirePackage{l3keys2e}

%=======================================================================================
%   SETUP

%---------------------------------------------------------------------------------------
%   OPTIONS

\tl_new:N \l__rpg_layout_justification_tl
\tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight }
\bool_new:N \l__rpg_layout_twocolumn_bool

\tl_new:N \l__rpg_layout_section_level_tl
\prop_new:N \g__rpg_layout_section_spacing_prop



%---------------------------------------------------------------------------------------
%   DEFAULTS

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { part / before }
    { .66ex plus .33ex minus .33ex }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { part / after }
    { 3ex }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { chapter / before }
    { .66ex plus .33ex minus .16ex }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { chapter / after }
    { 3ex }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { section / before }
    { 3ex plus .66ex minus .33ex }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { section / after }
    { 1.2ex plus .66ex minus .33ex }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subsection / before }
    { 2.4ex plus .66ex minus .33ex }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subsection / after }
    { 1.2ex plus .66ex minus .33ex }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subsubsection / before }
    { 1.8ex plus .66ex minus .33ex }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subsubsection / after }
    { 1.2ex plus .66ex minus .33ex }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { paragraph / before }
    { \dimexpr\parskip + .4ex\relax }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { paragraph / after }
    { .333em }

\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subparagraph / before }
    { \parskip }
\prop_gput:Nnn \g__rpg_layout_section_spacing_prop { subparagraph / after }
    { .333em }


\keys_define:nn { rpg / layout / options }
{
    justification .choice:,
    justification / raggedright .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    justification / ragged .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    justification / justified .code:n =
        { \tl_clear:N \l__rpg_layout_justification_tl },

    alignment .choice:,
    alignment / raggedright .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    alignment / ragged .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    alignment / justified .code:n =
        { \tl_clear:N \l__rpg_layout_justification_tl },

    columns .choice:,
    columns / one .code:n =
        { \bool_set_false:N \l__rpg_layout_twocolumn_bool },
    columns / two .code:n =
        { \bool_set_true:N \l__rpg_layout_twocolumn_bool },

    column .choice:,
    column / one .code:n =
        { \bool_set_false:N \l__rpg_layout_twocolumn_bool },
    column / two .code:n =
        { \bool_set_true:N \l__rpg_layout_twocolumn_bool },

    raggedright .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    ragged .code:n =
        { \tl_set:Nn \l__rpg_layout_justification_tl { \RaggedRight } },
    justified .code:n =
        { \tl_clear:N \l__rpg_layout_justification_tl },
    onecolumn .code:n =
        { \bool_set_false:N \l__rpg_layout_twocolumn_bool },
    twocolumn .code:n =
        { \bool_set_true:N \l__rpg_layout_twocolumn_bool },
}
\ProcessKeysOptions { rpg / layout / options }


\cs_generate_variant:Nn \prop_gput:Nnn { Nxn }

\cs_new_protected:Npn \__rpg_layout_section_spacing_put:nn #1#2
{
    \prop_gput:Nxn \g__rpg_layout_section_spacing_prop
        { \l__rpg_layout_section_level_tl / #1 }
        { #2 }
}

\cs_new_protected:Npn \__rpg_layout_section_spacing_set_level:nn #1#2
{
    \tl_set:Nn \l__rpg_layout_section_level_tl { #1 }
    \keys_set:nn { rpg / layout / section-spacing / level } { #2 }
}

\keys_define:nn { rpg / layout / section-spacing / level }
{
    before-skip .code:n =
        { \__rpg_layout_section_spacing_put:nn { before } { #1 } },
    before-skip .value_required:n = true,
    before .code:n =
        { \__rpg_layout_section_spacing_put:nn { before } { #1 } },
    before .value_required:n = true,

    after-skip .code:n =
        { \__rpg_layout_section_spacing_put:nn { after } { #1 } },
    after-skip .value_required:n = true,
    after .code:n =
        { \__rpg_layout_section_spacing_put:nn { after } { #1 } },
    after .value_required:n = true,
}

\keys_define:nn { rpg / layout / setup }
{
    part .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { part } { #1 } },
    chapter .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { chapter } { #1 } },
    section .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { section } { #1 } },
    subsection .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { subsection } { #1 } },
    subsubsection .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { subsubsection } { #1 } },
    paragraph .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { paragraph } { #1 } },
    subparagraph .code:n =
        { \__rpg_layout_section_spacing_set_level:nn { subparagraph } { #1 } },
}

\AtBeginDocument
{
    \bool_if:NT \l__rpg_layout_twocolumn_bool { \twocolumn }
    \RPGFontBody \RPGLayoutJustification
}



%---------------------------------------------------------------------------------------
%   INCLUDE

\RequirePackage{geometry}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{rpgcolor}
\RequirePackage{rpgfont}




%=======================================================================================
%   LAYOUT

%---------------------------------------------------------------------------------------
%   LENGTHS
    
\geometry
{%
    hmargin   = .75in, % Left and right margins
    top       = .46in, % Top of text area to top of page
    bottom    = .8in,  % Bottom of text area to bottom of page
    footskip  = .32in, % Bottom of text area to bottom of footer text
    columnsep = .33in, % Space between columns
}


% Set spacing around floats
\setlength{\textfloatsep}{11pt plus 4pt minus 4pt}
\setlength{\intextsep}{11pt plus 4pt minus 4pt}
\setlength{\dbltextfloatsep}{11pt plus 4pt minus 4pt}


% Set paragraph and line spacing
\setlength{\parindent}{1em}
\setlength{\RaggedRightRightskip}{0pt plus 1em}
\setlength{\RaggedRightParindent}{\parindent}


%---------------------------------------------------------------------------------------
%   TOLERANCES
    
% Restrict hyphenation
\tolerance        = 1
\emergencystretch = \maxdimen
\hyphenpenalty    = 10000
\hbadness         = 10000



%---------------------------------------------------------------------------------------
%   ENVIRONMENTS
    
% Customize itemize environment.
\setlist{leftmargin=1em}
\setitemize{noitemsep,topsep=0.5ex,label=\footnotesize{\textbullet}}



%=======================================================================================
%   COMMANDS

\NewDocumentCommand{\RPGLayoutJustification}
    {}
    {\l__rpg_layout_justification_tl}

\NewDocumentCommand{\RPGLayoutSectionBeforeSkip}
    {m}
    {\prop_item:Nn \g__rpg_layout_section_spacing_prop { #1 / before }}

\NewDocumentCommand{\RPGLayoutSectionAfterSkip}
    {m}
    {\prop_item:Nn \g__rpg_layout_section_spacing_prop { #1 / after }}

\NewDocumentCommand{\RPGLayoutSet}
    {m}
    {\keys_set:nn { rpg / layout / setup } { #1 }}
